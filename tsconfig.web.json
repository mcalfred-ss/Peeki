{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@renderer/*": ["./src/renderer/src/*"],
      "@modules/shared": ["./modules/shared/index.ts"],
      "@modules/shared/*": ["./modules/shared/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/widget/**/*",
    "src/renderer/askbar/**/*",
    "src/renderer/highlight/**/*",
    "src/preload/api.d.ts",
    "modules/shared/**/*"
  ]
}
